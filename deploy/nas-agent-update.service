# Mise à jour de l'agent depuis GitHub (voir nas-agent-update.sh). Lancé chaque nuit par
# nas-agent-update.timer, ou depuis la console (Compte › Agent › Rechercher).
[Unit]
Description=Mise à jour de l'agent NAS depuis les versions publiées sur GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nas-agent-update
# En douceur : le processeur est bridé et sans ventilateur (simple téléchargement, rien à compiler).
Nice=15
IOSchedulingClass=idle
